{
    "name": "adityadarma/docker-browsershot",
    "keywords": [
        "Docker",
        "Browsershot"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Aditya Darma",
            "email": "adhit.boys1@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "spatie/browsershot": "^5.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5",
        "roave/security-advisories": "dev-latest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testsuite Unit,Feature",
        "test:browser": "phpunit --testsuite Browser"
    },
    "config": {
        "sort-packages": true
    }
}
